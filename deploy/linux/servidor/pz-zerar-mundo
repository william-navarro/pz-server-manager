#!/bin/bash
# Zera somente o save do servidor; mantém configurações, mods e, por padrão, a whitelist.
set -euo pipefail
ENV_FILE=/etc/pzmanager/server.env
[[ -r "$ENV_FILE" ]] && . "$ENV_FILE"
: "${PZ_SERVER_NAME:=servertest}"
: "${PZ_ROOT:=/opt/pzserver}"
[[ "$PZ_SERVER_NAME" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo "PZ_SERVER_NAME inválido"; exit 2; }
[[ "$PZ_ROOT" == /* && "$PZ_ROOT" != / && "$PZ_ROOT" != *..* ]] || { echo "PZ_ROOT inválido"; exit 2; }
SAVE="$PZ_ROOT/Zomboid/Saves/Multiplayer/$PZ_SERVER_NAME"
DB="$PZ_ROOT/Zomboid/db/$PZ_SERVER_NAME.db"
DEST="$PZ_ROOT/mundos-antigos"
CONTAS=0
[[ " $* " == *" --contas "* ]] && CONTAS=1
if [[ " $* " != *" --sim "* ]]; then
  echo "Isto vai APAGAR o mundo atual ($(du -sh "$SAVE" 2>/dev/null | cut -f1)) e começar um novo."
  [[ $CONTAS = 1 ]] && echo "A whitelist também será apagada." || echo "Whitelist e configurações serão mantidas."
  echo "Para confirmar: sudo pz-zerar-mundo --sim$( [[ $CONTAS = 1 ]] && echo ' --contas')"
  exit 0
fi
[[ "$(id -u)" = 0 ]] || { echo "rode com sudo"; exit 1; }
pz-console 'servermsg "O mundo vai ser reiniciado agora."' 2>/dev/null || true
systemctl stop pzserver.service
STAMP=$(date +%Y%m%d-%H%M%S)
install -d -o pzserver -g pzserver -m 750 "$DEST"
ITEMS=("Saves/Multiplayer/$PZ_SERVER_NAME")
[[ $CONTAS = 1 ]] && ITEMS+=("db/$PZ_SERVER_NAME.db")
tar -czf "$DEST/mundo-$STAMP.tar.gz" -C "$PZ_ROOT/Zomboid" "${ITEMS[@]}"
chown pzserver:pzserver "$DEST/mundo-$STAMP.tar.gz"
find "$DEST" -maxdepth 1 -type f -name 'mundo-*.tar.gz' -printf '%T@ %p\n' |
  sort -nr | tail -n +4 | cut -d' ' -f2- | xargs -r rm -f --
rm -rf -- "$SAVE"
[[ $CONTAS = 1 ]] && rm -f -- "$DB"
T0=$(date +%s)
systemctl start pzserver.service
for _ in $(seq 1 120); do
  journalctl -u pzserver --since "@$T0" -o cat | grep -q "SERVER STARTED" && break
  sleep 5
done
systemctl is-active pzserver.service && echo "Mundo novo no ar. Backup do antigo: $DEST/mundo-$STAMP.tar.gz"
