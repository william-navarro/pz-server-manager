{
  "PzManager": {
    "DataRoot": "%LOCALAPPDATA%\\PzServerManager",
    "ListenUrl": "http://0.0.0.0:8085",
    "RequireHttpsCookie": false,
    "ManagedServer": {
      "DisplayName": "My PZ Server",
      "ServiceName": "pzserver.service",
      "InstallPath": "/opt/pzserver/pz",
      "DataPath": "/opt/pzserver/Zomboid",
      "ServerName": "servertest",
      "ConsoleFifo": "/run/pzserver/console",
      "BackupsPath": "/opt/pzserver/backups",
      "ServerVersion": "42.21"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
